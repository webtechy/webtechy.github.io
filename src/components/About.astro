---
import { profileData } from '../data/profile';
---

<section id="about" class="py-16 sm:py-20 border-t border-slate-200/80 dark:border-slate-800/80 bg-slate-100/50 dark:bg-slate-900/30">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Title -->
    <div class="max-w-3xl mb-12">
      <div class="inline-flex items-center gap-2 text-xs font-mono font-semibold uppercase tracking-wider text-blue-600 dark:text-blue-400 mb-2">
        <span>01 // Background & Philosophy</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-slate-900 dark:text-white">
        Architecture Without Waste.
      </h2>
      <p class="mt-4 text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed">
        {profileData.summary}
      </p>
    </div>

    <!-- The 4 Core Pillars Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {profileData.keyPillars.map((pillar) => (
        <div class="p-6 rounded-xl bg-white dark:bg-slate-900 border border-slate-200/90 dark:border-slate-800 shadow-xs hover:border-blue-500/50 dark:hover:border-blue-500/50 transition-all group">
          <div class="w-10 h-10 rounded-lg bg-blue-50 dark:bg-blue-950/60 border border-blue-100 dark:border-blue-800 flex items-center justify-center text-blue-600 dark:text-blue-400 mb-4 group-hover:scale-110 transition-transform">
            {pillar.icon === 'cloud' && (
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 00-9.78 2.096A4.001 4.001 0 003 15z"></path>
              </svg>
            )}
            {pillar.icon === 'network' && (
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"></path>
              </svg>
            )}
            {pillar.icon === 'server' && (
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01"></path>
              </svg>
            )}
            {pillar.icon === 'rocket' && (
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
              </svg>
            )}
          </div>
          <h3 class="text-lg font-semibold text-slate-900 dark:text-white mb-2">
            {pillar.title}
          </h3>
          <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
            {pillar.desc}
          </p>
        </div>
      ))}
    </div>

    <!-- Narrative Callout -->
    <div class="mt-8 p-6 rounded-xl bg-gradient-to-r from-blue-500/10 via-indigo-500/10 to-transparent border border-blue-200/50 dark:border-blue-800/40">
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div>
          <h4 class="text-base font-semibold text-slate-900 dark:text-white">
            Why avoid proprietary website builders & monolithic CMS?
          </h4>
          <p class="mt-1 text-sm text-slate-600 dark:text-slate-300 max-w-2xl">
            SaaS website builders charge hundreds or thousands each year while locking you into proprietary formats without true data ownership. By coupling modern static generators with private cloud storage (Nextcloud, Immich) and zero-cost edge hosting (GitHub Pages), you retain full sovereignty, near-zero hosting bills, and blistering speed.
          </p>
        </div>
        <a
          href="#homelab"
          class="shrink-0 px-4 py-2 text-xs font-semibold rounded-lg bg-blue-600 text-white hover:bg-blue-700 transition-colors shadow-xs"
        >
          See Homelab Architecture →
        </a>
      </div>
    </div>

  </div>
</section>
