---
import { Image } from 'astro:assets';
import homelabDiagram from '../assets/images/homelab-architecture.png';
import { profileData } from '../data/profile';

const homelabProject = profileData.projects.find((p) => p.id === 'homelab-private-cloud') || profileData.projects[0];
const otherProjects = profileData.projects.filter((p) => p.id !== 'homelab-private-cloud');
---

<section id="projects" class="py-16 sm:py-20 border-t border-slate-200/80 dark:border-slate-800/80 bg-slate-100/40 dark:bg-slate-900/20">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="max-w-3xl mb-12">
      <div class="inline-flex items-center gap-2 text-xs font-mono font-semibold uppercase tracking-wider text-blue-600 dark:text-blue-400 mb-2">
        <span>03 // Portfolio & Featured Engineering</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-slate-900 dark:text-white">
        Selected Architectures & Projects
      </h2>
      <p class="mt-2 text-sm sm:text-base text-slate-600 dark:text-slate-400">
        Hands-on systems engineering, hybrid-cloud networks, and automated developer tooling.
      </p>
    </div>

    <!-- FEATURED HERO PROJECT: HOMELAB -->
    <div id="homelab" class="scroll-mt-24 mb-14 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/90 dark:border-slate-800 overflow-hidden shadow-sm hover:shadow-md transition-shadow">
      
      <!-- Top Banner / Badge -->
      <div class="px-6 py-4 bg-gradient-to-r from-blue-600 to-indigo-600 text-white flex flex-wrap items-center justify-between gap-3">
        <div class="flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
          <span class="text-xs font-mono uppercase font-bold tracking-wider">Featured Architecture Deep Dive</span>
        </div>
        <span class="text-xs font-medium px-2.5 py-0.5 rounded-full bg-white/20 text-white backdrop-blur-xs">
          Hybrid Private Cloud
        </span>
      </div>

      <div class="p-6 sm:p-8 space-y-8">
        
        <!-- Project Header -->
        <div class="flex flex-col lg:flex-row lg:items-start justify-between gap-6">
          <div class="space-y-2 max-w-3xl">
            <h3 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white">
              {homelabProject.title}
            </h3>
            <p class="text-base text-blue-600 dark:text-blue-400 font-medium">
              {homelabProject.subtitle}
            </p>
            <p class="text-sm sm:text-base text-slate-600 dark:text-slate-300 leading-relaxed pt-1">
              {homelabProject.description}
            </p>
          </div>

          <!-- Actions & Tags -->
          <div class="flex flex-col items-start lg:items-end gap-3 shrink-0">
            {homelabProject.githubUrl && (
              <a
                href={homelabProject.githubUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-lg text-xs font-semibold bg-slate-900 text-white dark:bg-slate-100 dark:text-slate-900 hover:bg-slate-800 dark:hover:bg-white transition-all shadow-xs"
              >
                <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                  <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"></path>
                </svg>
                View Repository (mbabros/homelab) ↗
              </a>
            )}
            <div class="flex flex-wrap lg:justify-end gap-1.5 max-w-sm">
              {homelabProject.tags.map((tag) => (
                <span class="px-2.5 py-1 rounded-md text-xs font-mono font-medium bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700">
                  {tag}
                </span>
              ))}
            </div>
          </div>
        </div>

        <!-- Architecture Diagram Card with Zoom Lightbox -->
        <div class="space-y-3">
          <div class="flex items-center justify-between">
            <span class="text-xs font-mono font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">
              System Topology Diagram
            </span>
            <span class="text-xs text-blue-600 dark:text-blue-400 font-medium">
              Click diagram to expand full-screen
            </span>
          </div>

          <div
            id="diagram-container"
            class="group relative rounded-xl overflow-hidden border border-slate-200 dark:border-slate-800 bg-slate-950 cursor-pointer shadow-inner"
          >
            <Image
              src={homelabDiagram}
              alt="Homelab Architecture Diagram"
              class="w-full h-auto object-contain max-h-[500px] transition-transform duration-300 group-hover:scale-[1.01]"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-slate-900/0 group-hover:bg-slate-900/30 transition-colors flex items-center justify-center">
              <span class="opacity-0 group-hover:opacity-100 transition-opacity px-4 py-2 rounded-lg bg-black/75 text-white text-xs font-medium backdrop-blur-xs flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"></path>
                </svg>
                Click to Enlarge Architecture Diagram
              </span>
            </div>
          </div>
          <p class="text-xs text-center text-slate-500 dark:text-slate-400 italic">
            Refreshed Topology: Cloudflare wildcard DNS, OCI Caddy edge ingress, Tailscale WireGuard mesh, Coolify PaaS & Traefik v3 on Apple Silicon (OrbStack), and outbound GitHub Actions self-hosted runner.
          </p>
        </div>

        <!-- Architectural Component Breakdown Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-2">
          
          <!-- Cloudflare DNS -->
          <div class="p-4 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200/80 dark:border-slate-700/60">
            <div class="flex items-center gap-2 mb-2">
              <span class="w-2 h-2 rounded-full bg-amber-500"></span>
              <h4 class="text-sm font-bold text-slate-900 dark:text-white">Domain & DNS (Cloudflare)</h4>
            </div>
            <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
              Wildcard DNS management with automated DNS-01 ACME challenge resolution for wildcard Let's Encrypt certificates, DDoS mitigation, and global edge CDN caching.
            </p>
          </div>

          <!-- Proxy Layer (Oracle Cloud) -->
          <div class="p-4 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200/80 dark:border-slate-700/60">
            <div class="flex items-center gap-2 mb-2">
              <span class="w-2 h-2 rounded-full bg-red-500"></span>
              <h4 class="text-sm font-bold text-slate-900 dark:text-white">Edge Ingress (Oracle Cloud Free Tier)</h4>
            </div>
            <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
              Caddy reverse proxy on an Always-Free OCI VM terminating wildcard TLS and forwarding traffic across an encrypted Tailscale WireGuard mesh VPN directly to the Mac mini—bypassing residential ISP CGNAT with zero open firewall ports.
            </p>
          </div>

          <!-- Apple Silicon Compute Node -->
          <div class="p-4 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200/80 dark:border-slate-700/60">
            <div class="flex items-center gap-2 mb-2">
              <span class="w-2 h-2 rounded-full bg-blue-500"></span>
              <h4 class="text-sm font-bold text-slate-900 dark:text-white">PaaS & Ingress (Coolify & Traefik v3)</h4>
            </div>
            <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
              Hosted on Apple M4 Mac mini running OrbStack Docker Engine. Coolify PaaS controller orchestrates container lifecycles while Traefik v3.7 ingress handles dynamic host-based routing across modular Docker Compose stacks.
            </p>
          </div>

          <!-- GitOps CI/CD Node -->
          <div class="p-4 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200/80 dark:border-slate-700/60">
            <div class="flex items-center gap-2 mb-2">
              <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
              <h4 class="text-sm font-bold text-slate-900 dark:text-white">GitOps CI/CD (GitHub Actions Self-Hosted Runner)</h4>
            </div>
            <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
              Native Apple Silicon GitHub Actions runner communicating via outbound-only WebSockets. Detects repository commits, triggers local Coolify API webhooks, and executes automated rolling container updates with zero inbound attack surface.
            </p>
          </div>

        </div>
            <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
              Portainer-managed Docker platform running redundant private storage arrays, snapshot schedules, local network file shares (SMB/NFS), and automated backup mirrors.
            </p>
          </div>

        </div>

        <!-- Architectural Highlights Bullet Points -->
        <div class="pt-2 border-t border-slate-200/60 dark:border-slate-800/60">
          <h4 class="text-xs font-mono font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-3">
            Core Architecture Highlights
          </h4>
          <ul class="grid grid-cols-1 md:grid-cols-2 gap-2 text-xs text-slate-600 dark:text-slate-300">
            {homelabProject.highlights.map((h) => (
              <li class="flex items-start gap-2">
                <span class="text-emerald-500 font-bold shrink-0">✓</span>
                <span>{h}</span>
              </li>
            ))}
          </ul>
        </div>

      </div>
    </div>

    <!-- OTHER FEATURED PROJECTS GRID -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {otherProjects.map((project) => (
        <div class="p-6 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/90 dark:border-slate-800 shadow-xs flex flex-col justify-between hover:border-blue-500/50 dark:hover:border-blue-500/50 transition-all">
          <div class="space-y-4">
            
            <div class="flex items-start justify-between gap-2">
              <span class="text-xs font-mono font-medium px-2 py-0.5 rounded bg-blue-50 dark:bg-blue-950/60 text-blue-600 dark:text-blue-400 border border-blue-200/50 dark:border-blue-800/50">
                {project.category}
              </span>
              {project.githubUrl && (
                <a
                  href={project.githubUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-slate-400 hover:text-slate-700 dark:hover:text-white transition-colors"
                  title="View on GitHub"
                >
                  <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                    <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"></path>
                  </svg>
                </a>
              )}
            </div>

            <div>
              <h3 class="text-xl font-bold text-slate-900 dark:text-white">
                {project.title}
              </h3>
              <p class="text-xs font-medium text-blue-600 dark:text-blue-400 mt-0.5">
                {project.subtitle}
              </p>
              <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed mt-2">
                {project.description}
              </p>
            </div>

            <ul class="space-y-1.5 text-xs text-slate-600 dark:text-slate-300">
              {project.highlights.map((h) => (
                <li class="flex items-start gap-1.5">
                  <span class="text-blue-500 font-bold shrink-0 mt-0.5">›</span>
                  <span>{h}</span>
                </li>
              ))}
            </ul>

          </div>

          <div class="mt-6 pt-4 border-t border-slate-200/60 dark:border-slate-800/60 flex flex-wrap items-center justify-between gap-3">
            <div class="flex flex-wrap gap-1">
              {project.tags.map((tag) => (
                <span class="px-2 py-0.5 rounded text-[11px] font-mono bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400">
                  {tag}
                </span>
              ))}
            </div>

            {project.liveUrl && (
              <a
                href={project.liveUrl}
                class="text-xs font-semibold text-blue-600 dark:text-blue-400 hover:underline inline-flex items-center gap-1"
              >
                Learn more →
              </a>
            )}
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<!-- Lightbox Modal for Architecture Diagram -->
<div
  id="lightbox-modal"
  class="fixed inset-0 z-50 hidden bg-slate-950/90 backdrop-blur-md p-4 sm:p-8 flex items-center justify-center transition-all"
  role="dialog"
  aria-modal="true"
>
  <button
    id="close-lightbox"
    class="absolute top-4 right-4 sm:top-6 sm:right-6 p-2 rounded-full bg-slate-800/80 text-white hover:bg-slate-700 transition-colors focus:outline-none"
    aria-label="Close full diagram modal"
  >
    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
    </svg>
  </button>

  <div class="max-w-6xl max-h-[90vh] overflow-auto rounded-xl border border-slate-800 bg-slate-900 p-2">
    <img
      src={homelabDiagram.src}
      alt="Full Homelab Architecture Topology"
      class="w-full h-auto max-h-[85vh] object-contain rounded-lg"
    />
  </div>
</div>

<script>
  const diagramTrigger = document.getElementById('diagram-container');
  const modal = document.getElementById('lightbox-modal');
  const closeBtn = document.getElementById('close-lightbox');

  if (diagramTrigger && modal && closeBtn) {
    diagramTrigger.addEventListener('click', () => {
      modal.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    });

    const closeModal = () => {
      modal.classList.add('hidden');
      document.body.style.overflow = '';
    };

    closeBtn.addEventListener('click', closeModal);
    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
        closeModal();
      }
    });
  }
</script>
